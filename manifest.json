{
  "manifest_version": 3,
  "name": "Page Creator",
  "version": "1.0",
  "description": "Create a new page from the current page and a prompt.",
  "key": "",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "bookmarks",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Page Creator"
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "<all_urls>"
    ]
  }
}
